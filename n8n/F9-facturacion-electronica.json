{
  "name": "F9 - Facturas electronicas (Surtix)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "*/5 * * * *"
            }
          ]
        }
      },
      "id": "n1",
      "name": "Cada 5 minutos",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "url": "={{ $env.SURTIX_URL }}/api/webhooks/facturacion",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SURTIX_API_TOKEN }}"
            }
          ]
        },
        "method": "POST"
      },
      "id": "n2",
      "name": "Procesar facturas pendientes",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        420,
        300
      ]
    }
  ],
  "connections": {
    "Cada 5 minutos": {
      "main": [
        [
          {
            "node": "Procesar facturas pendientes",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/Bogota"
  },
  "pinData": {},
  "meta": {
    "nota": "Envía las facturas electrónicas pendientes al proveedor. Hoy solo existe el proveedor simulado (sin validez fiscal). Sin probar contra n8n real."
  }
}