{
  "name": "F4 - Cobranza (Surtix)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 10 * * 1-6"
            }
          ]
        }
      },
      "id": "n1",
      "name": "Todos los días 10 a. m.",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "url": "={{ $env.SURTIX_URL }}/api/webhooks/cobranza",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SURTIX_API_TOKEN }}"
            }
          ]
        }
      },
      "id": "n2",
      "name": "Pedir recordatorios",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        420,
        300
      ]
    },
    {
      "parameters": {
        "fieldToSplitOut": "recordatorios",
        "options": {}
      },
      "id": "n3",
      "name": "Un ítem por cliente",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        640,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v20.0/{{ $env.WHATSAPP_PHONE_NUMBER_ID }}/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.WHATSAPP_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messaging_product: 'whatsapp', to: $json.destino, type: 'text', text: { body: $json.mensaje } }) }}"
      },
      "id": "n4",
      "name": "Enviar WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        860,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst r = $('Un ítem por cliente').item.json;\nconst cuerpo = JSON.stringify({ cliente_id: r.cliente_id, nivel: r.nivel, saldo: r.saldo });\nconst fecha = String(Date.now());\nconst firma = crypto.createHmac('sha256', $env.N8N_WEBHOOK_SECRET).update(`${fecha}.${cuerpo}`).digest('hex');\nreturn { json: { cuerpo, fecha, firma } };"
      },
      "id": "n5",
      "name": "Firmar confirmación",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1080,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SURTIX_URL }}/api/webhooks/cobranza",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SURTIX_API_TOKEN }}"
            },
            {
              "name": "x-surtix-fecha",
              "value": "={{ $json.fecha }}"
            },
            {
              "name": "x-surtix-firma",
              "value": "={{ $json.firma }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.cuerpo }}"
      },
      "id": "n6",
      "name": "Confirmar a Surtix",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1300,
        300
      ]
    }
  ],
  "connections": {
    "Todos los días 10 a. m.": {
      "main": [
        [
          {
            "node": "Pedir recordatorios",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Pedir recordatorios": {
      "main": [
        [
          {
            "node": "Un ítem por cliente",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Un ítem por cliente": {
      "main": [
        [
          {
            "node": "Enviar WhatsApp",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Enviar WhatsApp": {
      "main": [
        [
          {
            "node": "Firmar confirmación",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Firmar confirmación": {
      "main": [
        [
          {
            "node": "Confirmar a Surtix",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/Bogota"
  },
  "pinData": {},
  "meta": {
    "nota": "Solo confirma a Surtix si WhatsApp aceptó el mensaje (el nodo de envío no continúa si falla). Sin probar contra n8n real."
  }
}
