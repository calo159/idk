{
  "name": "F2 - Resumen diario 8 p. m. (Surtix)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 20 * * *"
            }
          ]
        }
      },
      "id": "n1",
      "name": "Programación",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "url": "={{ $env.SURTIX_URL }}/api/webhooks/resumen?tipo=dia",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SURTIX_API_TOKEN }}"
            }
          ]
        }
      },
      "id": "n2",
      "name": "Pedir resúmenes a Surtix",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        420,
        300
      ]
    },
    {
      "parameters": {
        "fieldToSplitOut": "resumenes",
        "options": {}
      },
      "id": "n3",
      "name": "Un ítem por negocio",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        640,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v20.0/{{ $env.WHATSAPP_PHONE_NUMBER_ID }}/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.WHATSAPP_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messaging_product: 'whatsapp', to: $json.destino, type: 'text', text: { body: $json.mensaje } }) }}"
      },
      "id": "n4",
      "name": "Enviar mensaje por WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        860,
        300
      ],
      "onError": "continueRegularOutput"
    }
  ],
  "connections": {
    "Programación": {
      "main": [
        [
          {
            "node": "Pedir resúmenes a Surtix",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Pedir resúmenes a Surtix": {
      "main": [
        [
          {
            "node": "Un ítem por negocio",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Un ítem por negocio": {
      "main": [
        [
          {
            "node": "Enviar mensaje por WhatsApp",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/Bogota"
  },
  "pinData": {},
  "meta": {
    "nota": "Variables de n8n: SURTIX_URL, SURTIX_API_TOKEN, WHATSAPP_PHONE_NUMBER_ID, WHATSAPP_TOKEN. Sin probar contra n8n real."
  }
}
