# WhatsApp Cloud API (lo usa n8n, se deja aquí como referencia)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
TZ=America/Bogota
